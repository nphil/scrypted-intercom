         "MixinProvider",
         "Settings"
      ]
   },
   "dependencies": {
      "@scrypted/sdk": "^0.5.59"
   },
   "devDependencies": {
      "@scrypted/client": "^1.3.26",
      "@types/node": "^22.0.0",
      "terser-webpack-plugin": "^5.6.1",
      "typescript": "^5.9.0"
   }
}
